    {
      "name": "Destructive Button",
      "kind": "button",
      "refersTo": "button-destructive",
      "description": "The reset confirmation's destructive action.",
      "html": "<button class=\"ds-button ds-destructive\">Reset progress</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:36px;padding:0 11px;border:1px solid transparent;border-radius:5px;font:500 13px Geist,sans-serif;letter-spacing:0;cursor:pointer;box-shadow:none}.ds-button:focus-visible{outline:2px solid #95c9c8;outline-offset:3px}.ds-button:disabled{opacity:.64;pointer-events:none}@media(max-width:1100px),(hover:none) and (pointer:coarse){.ds-button{min-height:44px}}.ds-destructive{background:#b94348;color:#fff;border-color:#b94348}.ds-destructive:hover,.ds-destructive:active{background:rgb(185 67 72 / 90%)}"
