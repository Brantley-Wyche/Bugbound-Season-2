    {
      "name": "Incident Navigation",
      "kind": "nav",
      "refersTo": "incident-navigation",
      "description": "Expanded rail is 260px; the register link is a left-aligned 16px semibold h2 without an underline, above amber act headings. The heading row has one divider. Collapse retains a 64px rail and the same focused toggle. This sample shows the numbered active and locked lesson rows.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Incidents\"><a class=\"ds-nav-row\" href=\"#incident\" aria-current=\"page\"><span class=\"ds-index\">01</span><span>The Vanishing Venue</span></a><span class=\"ds-nav-row ds-locked\" aria-disabled=\"true\"><span>02</span><span>The Forgetful Cart</span><span aria-label=\"Locked\">-</span></span></nav>",
      "css": ".ds-nav{background:#131719;color:#eceeea;padding:12px;font:12px/1.4 Geist,sans-serif}.ds-nav-row{display:grid;grid-template-columns:22px minmax(0,1fr) 14px;align-items:center;gap:7px;padding:8px 9px;min-height:44px;border-radius:4px;color:inherit;text-decoration:none}.ds-nav-row[aria-current]{background:#2d383a;color:#eef5f2}.ds-nav-row:hover{background:#242c2e}.ds-nav-row:focus-visible{outline:2px solid #95c9c8;outline-offset:3px}.ds-index{color:#dfbe77;font:11px 'Geist Mono',monospace}.ds-locked{color:#a0aaa9}"
    },
    {
      "name": "Concept Reference",
      "kind": "custom",
      "refersTo": "concept-reference",
      "description": "Light, continuous reference surface; text remains fully expanded.",
      "html": "<aside class=\"ds-concept\"><h2 class=\"ds-concept-title\">Concept reference</h2><p class=\"ds-concept-label\">Concept reference</p><p class=\"ds-concept-body\">The full lesson remains available beside the investigation, including inline <code class=\"ds-concept-code\">src/app</code> references.</p></aside>",
      "css": ".ds-concept{background:#24292b;color:#eceeea;padding:29px 27px 40px;border-left:1px solid #566263;font-family:Geist,sans-serif}.ds-concept-title{font-size:22px;font-weight:550;line-height:1.25;margin:0}.ds-concept-label{color:#aeb7b6;font-size:11px;margin:10px 0 24px}.ds-concept-body{font-size:14px;line-height:1.8;margin:0}.ds-concept-code{font:12px 'Geist Mono',monospace;color:#95c9c8;background:#303638;padding:1px 3px;border-radius:2px;white-space:normal;overflow-wrap:anywhere}"
    },
    {
      "name": "Live Route Frame",
      "kind": "custom",
      "description": "A true frame around the live product under test, distinct from unframed page sections.",
      "html": "<section class=\"ds-preview\" aria-label=\"Live route preview\"><div class=\"ds-address\"><span class=\"ds-address-label\">Live route</span><code class=\"ds-address-code\">/lab/01-vanishing-venue</code></div><div class=\"ds-route-space\" aria-label=\"Route viewport\"></div></section>",
      "css": ".ds-preview{border:1px solid #536062;border-radius:6px;overflow:hidden}.ds-address{display:flex;gap:12px;align-items:center;padding:3px 5px 3px 12px;background:#282f31;min-height:44px;font-family:Geist,sans-serif}.ds-address-label{color:#bed5d2;font-size:11px}.ds-address-code{color:#b6c0c0;font:11px 'Geist Mono',monospace;overflow-wrap:anywhere}.ds-route-space{height:360px;background:#0a0d12}@media(min-width:1600px){.ds-route-space{height:420px}}@media(max-width:420px){.ds-address-label{display:none}.ds-route-space{height:350px}}"
    },
    {
      "name": "Hint Disclosure",
      "kind": "custom",
      "description": "Visual translation of the coss Accordion; actual application uses Base UI semantics and multiple independent disclosures.",
      "html": "<details class=\"ds-hint\"><summary class=\"ds-hint-trigger\"><span class=\"ds-hint-index\">01</span> Gentle nudge</summary><p class=\"ds-hint-panel\">Optional guidance appears after deliberate disclosure.</p></details>",
      "css": ".ds-hint{background:#1b1e20;color:#eceeea;border-bottom:1px solid #394143;font:13px/1.7 Geist,sans-serif}.ds-hint-trigger{padding:16px 0;cursor:pointer;font-weight:500}.ds-hint-trigger:hover{color:#fff}.ds-hint-trigger:focus-visible{outline:2px solid #95c9c8;outline-offset:3px}.ds-hint-index{font:11px 'Geist Mono',monospace;color:#dfbe77;margin-right:14px}.ds-hint-panel{color:#aeb7b6;margin:0;padding-bottom:16px}"
    }
  ],
  "narrative": {
    "northStar": "Investigation Desk",
    "overview": "Investigation Desk is Bugbound Season 2's code-led visual world: a graphite working environment with amber incident indexing, restrained teal tool details, and a subtly lifted graphite Concept reference surface. It carries the Bugbound naming and incident notation forward with warm, readable typography and purposeful detail.\n\nThe system is flat and task-focused. Persistent navigation, ruled information, a framed live route, and a dedicated reference surface establish hierarchy without turning every section into a card. The current implementation and approved PRODUCT.md commitment are the authority; no approved generated comp or quality-bar card is recorded.",
    "keyCharacteristics": [
      "Graphite working surfaces and a graphite reference surface.",
      "Amber indexing and primary commands; teal focus and tool details.",
      "Readable Geist prose with selective Geist Mono incident notation.",
      "Ruled sections, compact native controls, and explicit progress states."
    ],
    "rules": [],
    "dos": [
      "Do keep the full Concept reference expanded beside the investigation on desktop.",
      "Do use coss UI controls with Base UI render composition and stable data-size/data-variant styling.",
      "Do preserve readable wrapping, visible focus, reduced-motion behavior, and labeled icon actions.",
      "Do distinguish earned completion, saved completion, and the latest verification result.",
      "Do keep design changes scoped to the workspace; the lab retains its independent visual world."
    ],
    "donts": [
      "Don't restore colored side-border cards, decorative dot grids, terminal costume, or decorative dashboard metrics.",
      "Don't promote retained legacy Card or Badge primitives into the Investigation Desk's visual authority.",
      "Don't collapse the Concept reference or turn optional hints into automatically revealed guidance.",
      "Don't treat code-led direction as evidence of an approved generated comp or quality-bar card."
    ]
  }
}
