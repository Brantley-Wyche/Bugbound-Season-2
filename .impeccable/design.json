      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:36px;padding:0 11px;border:1px solid transparent;border-radius:5px;font:500 13px Geist,sans-serif;letter-spacing:0;cursor:pointer;box-shadow:none}.ds-button:focus-visible{outline:2px solid #95c9c8;outline-offset:3px}.ds-button:disabled{opacity:.64;pointer-events:none}@media(max-width:1100px),(hover:none) and (pointer:coarse){.ds-button{min-height:44px}}.ds-ghost{width:36px;height:36px;padding:0;background:transparent;color:#eceeea}.ds-ghost:hover,.ds-ghost:active{background:#353e40}@media(max-width:1100px),(hover:none) and (pointer:coarse){.ds-ghost{width:44px;height:44px}}"
